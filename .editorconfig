# 编辑器基础约定：避免锁文件、SQL、Markdown 出现混合换行或行尾空白。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown 行尾两个空格是硬换行，不能删
trim_trailing_whitespace = false

[*.sql]
indent_size = 2

[Makefile]
indent_style = tab
